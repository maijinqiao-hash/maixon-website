---
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import DownloadSelector from "@/components/DownloadSelector.astro";
import { getMedia, type Locale } from "@/data/media";
import "@/styles/global.css";

interface Props {
  locale: Locale;
  title: string;
  description: string;
  downloadLabel: string;
  menuLabel: string;
  imageId?: string;
}

const { locale, title, description, downloadLabel, menuLabel, imageId = "brand-app-icon" } = Astro.props;
const socialImage = getMedia(imageId, locale);
const socialImageSrc = socialImage.original_src ?? socialImage.src;
const canonical = new URL(Astro.url.pathname, Astro.site);
const alternateLocale: Locale = locale === "zh-CN" ? "en" : "zh-CN";
const alternatePath = Astro.url.pathname.startsWith(`/${locale}/`)
  ? Astro.url.pathname.replace(`/${locale}/`, `/${alternateLocale}/`)
  : `/${alternateLocale}/`;
const zhPath = locale === "zh-CN" ? Astro.url.pathname : alternatePath;
const enPath = locale === "en" ? Astro.url.pathname : alternatePath;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#ffffff" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="zh-CN" href={new URL(zhPath, Astro.site)} />
    <link rel="alternate" hreflang="en" href={new URL(enPath, Astro.site)} />
    <link rel="alternate" hreflang="x-default" href={new URL("/", Astro.site)} />
    <link rel="icon" type="image/png" href={socialImageSrc} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="MAIXON" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(socialImageSrc, Astro.site)} />
    <meta property="og:locale" content={locale === "zh-CN" ? "zh_CN" : "en_US"} />
    <meta property="og:locale:alternate" content={locale === "zh-CN" ? "en_US" : "zh_CN"} />
    <meta name="twitter:card" content="summary_large_image" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">{locale === "zh-CN" ? "跳到主要内容" : "Skip to content"}</a>
    <Header
      locale={locale}
      alternatePath={alternatePath}
      downloadLabel={downloadLabel}
      menuLabel={menuLabel}
    />
    <main id="main">
      <slot />
    </main>
    <Footer locale={locale} />
    <DownloadSelector locale={locale} />
    <script>
      const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
      const videos = Array.from(document.querySelectorAll("video[data-autoplay-media]"))
        .filter((node): node is HTMLVideoElement => node instanceof HTMLVideoElement);

      const isRendered = (video: HTMLVideoElement) => Boolean(video.offsetWidth || video.offsetHeight || video.getClientRects().length);
      const isOnScreen = (video: HTMLVideoElement) => {
        const rect = video.getBoundingClientRect();
        return rect.bottom > 0 && rect.top < window.innerHeight && rect.right > 0 && rect.left < window.innerWidth;
      };

      const playVideo = (video: HTMLVideoElement, restart = false) => {
        if (reduceMotion.matches || document.hidden || !isRendered(video)) {
          video.pause();
          return;
        }
        if (restart || video.ended) video.currentTime = 0;
        video.muted = true;
        video.play().catch(() => {});
      };

      const syncProgress = (video: HTMLVideoElement) => {
        const progress = video.closest(".media-frame__viewport")?.querySelector("[data-media-progress]");
        if (!(progress instanceof HTMLInputElement)) return;
        const duration = Number.isFinite(video.duration) && video.duration > 0 ? video.duration : 0;
        const ratio = duration ? Math.min(1, Math.max(0, video.currentTime / duration)) : 0;
        progress.value = String(Math.round(ratio * 1000));
        progress.style.setProperty("--media-progress", `${ratio * 100}%`);
      };

      videos.forEach((video) => {
        video.muted = true;
        video.playsInline = true;
        ["loadedmetadata", "durationchange", "timeupdate", "ended"].forEach((eventName) => {
          video.addEventListener(eventName, () => syncProgress(video));
        });

        const progress = video.closest(".media-frame__viewport")?.querySelector("[data-media-progress]");
        if (progress instanceof HTMLInputElement) {
          progress.addEventListener("input", () => {
            if (!Number.isFinite(video.duration) || video.duration <= 0) return;
            video.currentTime = (Number(progress.value) / 1000) * video.duration;
            syncProgress(video);
          });
        }
      });

      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          const video = entry.target;
          if (!(video instanceof HTMLVideoElement)) return;
          if (entry.isIntersecting && entry.intersectionRatio >= 0.2) playVideo(video);
          else video.pause();
        });
      }, { threshold: [0, 0.2, 0.5, 0.8] });

      videos.forEach((video) => observer.observe(video));

      document.addEventListener("maixon:media-activate", (event) => {
        const video = event.target;
        if (!(video instanceof HTMLVideoElement)) return;
        playVideo(video, true);
      });

      const updateMotion = () => {
        videos.forEach((video) => {
          if (reduceMotion.matches) {
            video.pause();
            video.currentTime = 0;
            syncProgress(video);
          } else if (isOnScreen(video)) {
            playVideo(video);
          }
        });
      };

      document.addEventListener("visibilitychange", updateMotion);
      reduceMotion.addEventListener("change", updateMotion);
      updateMotion();
    </script>
  </body>
</html>
