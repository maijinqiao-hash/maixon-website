---
import ManualDocument from '@/components/ManualDocument.astro';
import {legacySections} from '@/data/manual-v92/render';
export function getStaticPaths(){
  return ['en','th','ja','ko','ms','id','vi'].flatMap(locale=>
    Object.keys(legacySections).map(topic=>({params:{locale,topic}}))
  );
}
const locale=Astro.params.locale!;
const initialSection=legacySections[Astro.params.topic!]||'';
---
<ManualDocument locale={locale} initialSection={initialSection}/>
