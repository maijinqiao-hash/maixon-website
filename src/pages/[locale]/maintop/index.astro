---
import SiteLayout from '@/layouts/SiteLayout.astro';
import V86MaintopDemo from '@/components/V86MaintopDemo.astro';
import V86DemoCollection from '@/components/V86DemoCollection.astro';
import V86Behavior from '@/components/V86Behavior.astro';
export function getStaticPaths(){return ['zh-CN','en'].map(locale=>({params:{locale}}));}
const locale=Astro.params.locale as 'zh-CN'|'en';const zh=locale==='zh-CN';
const steps=zh?['在 MAIXON 完成图像处理、尺寸和白墨设置','完成排版与输出，确认生产文件','自动接入 MainTop，衔接后续处理','在打印机软件中复核任务，再点击“打印”']:['Prepare the image, dimensions and white ink in MAIXON','Complete the layout, export and inspect the production file','Automatically continue into MainTop','Review the job in the printer software, then press Print'];
---
<SiteLayout locale={locale} title={zh?'自动接入 MainTop · MAIXON TOOL V8.6':'Automatic MainTop integration · MAIXON TOOL V8.6'} description={zh?'从图稿、白墨与排版到自动接入蒙泰，把点击打印之前的准备工作连接起来。':'Connect image preparation, white ink and layouts to MainTop before Print.'} downloadLabel={zh?'下载':'Download'} menuLabel={zh?'菜单':'Menu'}>
<div class="v86-root v86-maintop-page" data-v86-page><header class="v86-section v86-guide-head"><nav class="v86-breadcrumb"><a href={`/${locale}/`}>MAIXON</a><span>/</span><span>MainTop</span></nav><p class="v86-eyebrow">MAIXON × MainTop</p><h1>{zh?<>打印之前，<br/>让准备自动衔接。</>:<>Before Print.<br/>Let preparation flow.</>}</h1><p class="v86-lead">{zh?'从 AI 图稿到白墨、排版与文件输出，再自动接入蒙泰。把原本需要反复切换的操作串起来，把精力留给订单与生产。':'From AI artwork to white ink, layouts and file output, then automatically into MainTop. Connect the repeated steps and focus on production.'}</p></header><div class="v86-section v86-guide-main"><V86MaintopDemo locale={locale}/><article class="v86-guide-copy"><h2>{zh?'从图稿，到打印前一步。':'From artwork to the step before printing.'}</h2><ol>{steps.map(step=><li>{step}</li>)}</ol><h3>{zh?'白墨烫画与白墨直喷，各有完整路径。':'Connected workflows for DTF and DTG.'}</h3><p>{zh?'白墨烫画可以从单图或整版出发，完成白墨通道后衔接蒙泰；白墨直喷则按面料与白墨量完成制图，再进入对应处理。先配好蒙泰设置，在生产模块中启用自动接入。':'DTF can start from one image or a completed sheet. DTG uses fabric and white-ink settings. Configure MainTop first, then enable automatic integration in the production module.'}</p></article><div class="v86-benefit-grid">{['dtf','dtg'].map(feature=><a class="v86-maintop-link" href={`/${locale}/features/${feature}/maintop/`}><span><small>{feature.toUpperCase()} × MainTop</small><strong>{zh?(feature==='dtf'?'白墨烫画自动接入':'白墨直喷自动接入'):`${feature.toUpperCase()} integration`}</strong></span><span>↗</span></a>)}</div><section class="v86-related"><h2>{zh?'设置一次，让流程衔接起来。':'Set up the connection.'}</h2><V86DemoCollection ids={['maintop-setup','dtf-canvas','dtg-ai-new']} locale={locale}/></section><div class="v86-guide-links"><a class="v86-text-link" href={`/${locale}/`}>← {zh?'返回软件首页':'Back to software'}</a><a class="v86-text-link" href={`/${locale}/tour/#workflows`}>{zh?'全部操作视频':'All workflows'} →</a></div></div></div><V86Behavior/>
</SiteLayout>
