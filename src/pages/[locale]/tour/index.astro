---
import SiteLayout from '@/layouts/SiteLayout.astro';
import V86Media from '@/components/V86Media.astro';
import V86DemoCollection from '@/components/V86DemoCollection.astro';
import {demos} from '@/data/v86/demos';
import V86Behavior from '@/components/V86Behavior.astro';
import V86SubfeatureIndex from '@/components/V86SubfeatureIndex.astro';
import {features,type V86Locale} from '@/data/v86/content';
export function getStaticPaths(){return ['zh-CN','en'].map(locale=>({params:{locale}}));}
const locale=Astro.params.locale as V86Locale;const zh=locale==='zh-CN';
---
<SiteLayout locale={locale} title={zh?'V8.6 完整功能与操作指南 · MAIXON':'V8.6 features and walkthroughs · MAIXON'} description={zh?'从图稿到生产文件，逐步了解 MAIXON TOOL V8.6。深浅色界面、功能说明与完整操作流程。':'Explore MAIXON TOOL V8.6 step by step, with light and dark interfaces, feature guides and complete workflows.'} downloadLabel={zh?'下载':'Download'} menuLabel={zh?'菜单':'Menu'}>
<div class="v86-root" data-v86-page><header class="v86-section v86-guide-head"><nav class="v86-breadcrumb"><a href={`/${locale}/`}>MAIXON</a><span>/</span><span>{zh?'功能与教程':'Features and guides'}</span></nav><p class="v86-eyebrow">MAIXON TOOL V8.6</p><h1>{zh?<>每一步，<br/>都看得明白。</>:<>Every step.<br/>Clearly explained.</>}</h1><p class="v86-lead">{zh?'从找到一张图，到输出一份生产文件。逐个了解功能入口、关键参数与操作顺序，沿着清楚的步骤，完成你的工作流程。':'From finding an image to exporting a production file. Explore the controls, key settings and steps in one connected workflow.'}</p></header><div class="v86-section v86-guide-main"><V86Media id="tour-overview" poster="overview" video="overview" locale={locale} priority/><div class="v86-tour-list">{features[locale].map((f,i)=><a class="v86-tour-card" href={`/${locale}/features/${f.id}/`}><small>{String(i+1).padStart(2,'0')} · V8.6</small><h2>{f.tag}</h2><p>{f.lead}</p><span>{zh?'进入操作指南':'Open walkthrough'} ↗</span></a>)}<a class="v86-tour-card" href={`/${locale}/maintop/`}><small>08 · MAIXON × MainTop</small><h2>{zh?'自动接入蒙泰':'Automatic MainTop integration'}</h2><p>{zh?'从 MAIXON 输出，到打印前的最后一步。':'From MAIXON output to the last step before printing.'}</p><span>{zh?'了解完整流程':'Explore the workflow'} ↗</span></a></div><section class="v86-related" id="feature-topics"><p class="v86-eyebrow">{zh?'功能专题':'FEATURE TOPICS'}</p><h2>{zh?'从具体任务，找到操作方法。':'Find the guide for your task.'}</h2>{features[locale].map(f=><V86SubfeatureIndex feature={f.id} locale={locale} compact title={f.tag}/>)}</section><section class="v86-related v86-owner-library" id="workflows"><p class="v86-eyebrow">{zh?'操作视频':'WORKFLOWS'}</p><h2>{zh?'从第一步，看到完成。':'From the first step to completion.'}</h2><V86DemoCollection ids={demos.map(d=>d.id)} locale={locale}/></section><article class="v86-guide-copy"><h2>{zh?'开始前，先连好工作环境。':'Connect your workspace first.'}</h2><ol><li>{zh?'在设置中确认 Photoshop 路径和连接状态。图像生产模块需要对应的 Photoshop 工作环境。':'Confirm the Photoshop path and connection in Settings before using Photoshop-based production tools.'}</li><li>{zh?'选择专门的输出目录，保留原稿，避免把结果与输入文件混在一起。':'Use a dedicated output folder and keep the original artwork.'}</li><li>{zh?'确认当前账号、模块授权和 AI 点数；不同服务的状态分别查看。':'Check the account, module license and AI credits separately.'}</li><li>{zh?'每次生产前，核对成品尺寸、白墨、颜色和 RIP 预览，再做实际打样。':'Check size, white ink, color and RIP preview before a physical print sample.'}</li></ol></article><div class="v86-gallery">{['settings','help','about'].map((poster,i)=><V86Media id={`common-${poster}`} poster={poster} locale={locale} caption={(zh?['设置与 Photoshop 连接','软件内使用说明','V8.6 版本信息']:['Settings and Photoshop connection','In-app help','V8.6 version information'])[i]}/>)}</div><div class="v86-guide-links"><a class="v86-text-link" href={`/${locale}/`}>← {zh?'返回软件首页':'Back to software'}</a><a class="v86-text-link" href={`/${locale}/guide/`}>{zh?'安装、账号与支持':'Installation, accounts and support'} →</a></div></div></div><V86Behavior />
</SiteLayout>
