---
import BalancedTitle from "@/components/BalancedTitle.astro";
import SiteLayout from "@/layouts/SiteLayout.astro";
import { copy } from "@/data/site";
import type { Locale } from "@/data/media";

export function getStaticPaths() {
  return [{ params: { locale: "zh-CN" } }, { params: { locale: "en" } }];
}

const locale = Astro.params.locale as Locale;
const content = copy[locale];
const items = locale === "zh-CN"
  ? [
      { title: content.support.guide, body: "查看安装、账号、DTF、DTG、热升华与 MAIXON AI 的操作方法。", href: `/${locale}/guide/` },
      { title: content.support.contact, body: "通过电话、微信或 WhatsApp 联系 MAIXON。", href: `/${locale}/contact/` },
      { title: content.support.authorization, body: "查看软件授权、MAIXON AI 点数方案与开通流程。", href: `/${locale}/authorization/` }
    ]
  : [
      { title: content.support.guide, body: "Guidance for setup, accounts, DTF, DTG, Sublimation and MAIXON AI.", href: `/${locale}/guide/` },
      { title: content.support.contact, body: "Contact MAIXON by phone, WeChat or WhatsApp.", href: `/${locale}/contact/` },
      { title: content.support.authorization, body: "Review software licenses, MAIXON AI credit packages and activation steps.", href: `/${locale}/authorization/` }
    ];
---

<SiteLayout
  locale={locale}
  title={`${content.support.title} | MAIXON`}
  description={content.support.body}
  downloadLabel={content.header.download}
  menuLabel={content.header.menu}
>
  <section class="page-hero page-hero--compact" id="license">
    <p class="section-label">{content.support.label}</p>
    <BalancedTitle as="h1" text={content.support.title} segments={content.support.titleSegments} />
    <p>{content.support.body}</p>
  </section>
  <section class="support-index">
    {items.map((item, index) => (
      <a href={item.href}>
        <span>{String(index + 1).padStart(2, "0")}</span>
        <h2>{item.title}</h2>
        <p>{item.body}</p>
      </a>
    ))}
  </section>
</SiteLayout>
