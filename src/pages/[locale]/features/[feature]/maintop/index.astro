---
import SiteLayout from '@/layouts/SiteLayout.astro';
import V86OwnerVideo from '@/components/V86OwnerVideo.astro';
import V86DemoCollection from '@/components/V86DemoCollection.astro';
import V86Behavior from '@/components/V86Behavior.astro';
export function getStaticPaths(){return ['zh-CN','en'].flatMap(locale=>['dtf','dtg'].map(feature=>({params:{locale,feature}})));}
const locale=Astro.params.locale as 'zh-CN'|'en';const zh=locale==='zh-CN';const dtf=Astro.params.feature==='dtf';const name=dtf?'DTF':'DTG';const chinese=dtf?'白墨烫画':'白墨直喷';
const steps=zh?(dtf?['选择单图、个数排版、多图或指定画布，完成图稿与整版。','在 Photoshop 核对数量、尺寸和图案边缘，生成白墨通道及生产文件。','启用自动接入蒙泰，让文件继续进入 MainTop 处理。','检查蒙泰中的任务、图稿方向与输出，再进行打印。']:['从 Photoshop 图稿或 AI 结果进入白墨直喷。','选择面料，分别设定普通区域与黑色区域的白墨量，核对尺寸和边缘。','开启自动接入蒙泰，完成制图后继续进入 MainTop。','检查任务与输出，按面料和设备完成打印前复核。']):(dtf?['Choose Single Artwork, Repeated Layout, Multiple-image Layout or Custom Canvas to prepare the job.','In Photoshop, review quantity, dimensions and edges, then create the white-ink channel and production files.','Enable automatic integration to continue processing in MainTop.','Check the MainTop job, artwork direction and output before printing.']:['Continue into DTG from Photoshop artwork or an AI result.','Choose the fabric, set white ink independently for regular and black regions, then review size and edges.','Enable automatic MainTop integration to continue after artwork processing.','Inspect the job and output, then complete the checks required by your fabric and equipment.']);
---
<SiteLayout locale={locale} title={`${name} · ${zh?'自动接入蒙泰':'Automatic MainTop integration'} · MAIXON`} description={zh?`${chinese}从制图到自动接入蒙泰的完整工作流程。`:`The connected ${name} workflow from artwork to MainTop.`} downloadLabel={zh?'下载':'Download'} menuLabel={zh?'菜单':'Menu'}>
<div class="v86-root" data-v86-page><header class="v86-section v86-guide-head"><nav class="v86-breadcrumb"><a href={`/${locale}/`}>MAIXON</a><span>/</span><a href={`/${locale}/features/${name.toLowerCase()}/`}>{zh?`${name} · ${chinese}`:name}</a><span>/</span><span>MainTop</span></nav><p class="v86-eyebrow">{zh?`${name} · ${chinese}`:name} × MainTop</p><h1>{zh?<>{chinese}做好。<br/>蒙泰，自动接上。</>:<>{name} prepared.<br/>MainTop connected.</>}</h1><p class="v86-lead">{zh?(dtf?'从一张图到一整版，完成尺寸、排版和白墨，再自动进入蒙泰。让一份订单沿着同一条流程走到打印前。':'按面料完成图稿与白墨设置，制图后自动进入蒙泰。减少手动导入与来回切换，让准备工作连续完成。'):`Prepare the artwork and white ink, then automatically continue into MainTop.`}</p></header><div class="v86-section v86-guide-main"><V86OwnerVideo id={dtf?'dtf-ai-flow':'dtg-ai-new'} locale={locale}/><article class="v86-guide-copy"><h2>{zh?'制图、通道、蒙泰。一条流程。':'Artwork, white ink and MainTop. Connected.'}</h2><ol>{steps.map(s=><li>{s}</li>)}</ol><h3>{zh?'先配好，再启用。':'Configure first, then enable.'}</h3><p>{zh?'通过自动接入蒙泰旁的设置，确认自动匹配的程序、输出路径与 ICC 配置，再启用自动接入。每份任务完成后，核对图稿、尺寸和输出文件。':'Open the settings beside automatic MainTop integration. Confirm the detected program, output folder and ICC configuration, then enable integration. Review artwork, dimensions and output after each task.'}</p></article><section class="v86-related"><h2>{zh?'按你的任务，继续了解。':'Explore your workflow.'}</h2><V86DemoCollection ids={dtf?['dtf-single','dtf-count','dtf-stretch','dtf-canvas','maintop-setup']:['dtg-ai','maintop-setup']} locale={locale}/></section><div class="v86-guide-links"><a class="v86-text-link" href={`/${locale}/features/${name.toLowerCase()}/`}>← {zh?chinese:name}</a><a class="v86-text-link" href={`/${locale}/maintop/`}>{zh?'自动接入蒙泰':'MainTop integration'} →</a></div></div></div><V86Behavior/>
</SiteLayout>
