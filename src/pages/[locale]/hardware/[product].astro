---
import HardwareProductPage from "@/components/hardware/HardwareProductPage.astro";
import SiteLayout from "@/layouts/SiteLayout.astro";
import { copy } from "@/data/site";
import { getHardwareSpecValue, hardwareProducts, type HardwareProductKey } from "@/data/hardware";
import type { Locale } from "@/data/media";

export function getStaticPaths() {
  const keys: HardwareProductKey[] = ["dtf604", "dfg604", "dtf608", "oven604"];
  return (["zh-CN", "en"] as const).flatMap((locale) =>
    keys.map((product) => ({ params: { locale, product } }))
  );
}

const locale = Astro.params.locale as Locale;
const productKey = Astro.params.product as HardwareProductKey;
const product = hardwareProducts[productKey];
const siteCopy = copy[locale];
const structuredData = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Product",
  name: product.name,
  description: product.seoDescription[locale],
  category: product.type[locale],
  brand: { "@type": "Brand", name: "MAIXON" },
  url: new URL(product.href[locale], Astro.site).toString(),
  image: new URL(`/media-responsive/hardware/${product.mediaId.replace("hardware-", "")}-full.webp`, Astro.site).toString(),
  additionalProperty: product.specifications.map((spec) => ({
    "@type": "PropertyValue",
    name: spec.label[locale],
    value: getHardwareSpecValue(spec, locale)
  }))
});
---

<SiteLayout
  locale={locale}
  title={product.seoTitle[locale]}
  description={product.seoDescription[locale]}
  downloadLabel={siteCopy.header.download}
  menuLabel={siteCopy.header.menu}
  imageId={product.mediaId}
>
  <script is:inline type="application/ld+json" set:html={structuredData}></script>
  <HardwareProductPage locale={locale} productKey={productKey} />
</SiteLayout>
