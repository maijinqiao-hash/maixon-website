---
import MediaFrame from "@/components/MediaFrame.astro";
import SiteLayout from "@/layouts/SiteLayout.astro";
import { copy } from "@/data/site";
import type { Locale } from "@/data/media";

export function getStaticPaths() {
  return [{ params: { locale: "zh-CN" } }, { params: { locale: "en" } }];
}

const locale = Astro.params.locale as Locale;
const content = copy[locale];
---

<SiteLayout
  locale={locale}
  title={locale === "zh-CN" ? "MAIXON 硬件｜V5.9 生产生态" : "MAIXON Hardware | V5.9 Production Ecosystem"}
  description={content.hardware.body}
  downloadLabel={content.header.download}
  menuLabel={content.header.menu}
>
  <section class="page-hero page-hero--compact">
    <p class="section-label">{content.hardware.label}</p>
    <h1>{content.hardware.title}</h1>
    <p>{content.hardware.body}</p>
  </section>
  <section class="product-index">
    {content.hardware.products.map((product, index) => (
      <article>
        <a href={product.href}>
          <span class="product-index__number">{String(index + 1).padStart(2, "0")}</span>
          <div class="product-index__media">
            <MediaFrame id={product.mediaId} locale={locale} alt={product.name} />
          </div>
          <div>
            <h2>{product.name}</h2>
            <p class="hardware-product__type">{product.type}</p>
            <p>{product.description}</p>
            <small>{content.hardware.provisional}</small>
          </div>
        </a>
      </article>
    ))}
  </section>
</SiteLayout>
