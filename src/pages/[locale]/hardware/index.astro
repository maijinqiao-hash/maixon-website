---
import HardwareOverview from "@/components/hardware/HardwareOverview.astro";
import SiteLayout from "@/layouts/SiteLayout.astro";
import { copy } from "@/data/site";
import { hardwareOverviewCopy, hardwareProducts, printerOrder } from "@/data/hardware";
import type { Locale } from "@/data/media";

export function getStaticPaths() {
  return [{ params: { locale: "zh-CN" } }, { params: { locale: "en" } }];
}

const locale = Astro.params.locale as Locale;
const siteCopy = copy[locale];
const overview = hardwareOverviewCopy[locale];
const title = locale === "zh-CN" ? "MAIXON 硬件｜DFG604、DTF604、DTF608 与 OVEN604" : "MAIXON Hardware | DFG604, DTF604, DTF608 & OVEN604";
const description = overview.body;
const productList = [...printerOrder, "oven604" as const].map((key, position) => ({
  "@type": "ListItem",
  position: position + 1,
  url: new URL(hardwareProducts[key].href[locale], Astro.site).toString(),
  name: hardwareProducts[key].name
}));
const structuredData = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: title,
  description,
  itemListElement: productList
});
---

<SiteLayout locale={locale} title={title} description={description} downloadLabel={siteCopy.header.download} menuLabel={siteCopy.header.menu}>
  <script is:inline type="application/ld+json" set:html={structuredData}></script>
  <HardwareOverview locale={locale} surface="index" />
</SiteLayout>
