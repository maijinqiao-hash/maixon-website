---
import { getMedia, type Locale } from "@/data/media";

interface Props {
  id: string;
  locale: Locale;
  posterId?: string;
  alt?: string;
  caption?: string;
  class?: string;
  priority?: boolean;
  autoplay?: boolean;
  loop?: boolean;
}

const {
  id,
  locale,
  posterId,
  alt,
  caption,
  class: className = "",
  priority = false,
  autoplay = false,
  loop = false
} = Astro.props;

const media = getMedia(id, locale);
const poster = posterId ? getMedia(posterId, locale) : undefined;
const resolvedAlt =
  alt ??
  media.alt?.[locale] ??
  (locale === "zh-CN" ? "MAIXON V6.3.2 产品媒体" : "MAIXON V6.3.2 product media");
const srcset = media.srcset.map((source) => `${source.src} ${source.width}w`).join(", ");
const avifSrcset = (media.srcset_avif ?? [])
  .map((source) => `${source.src} ${source.width}w`)
  .join(", ");
---

<figure
  class:list={["media-frame", className]}
  style={`--media-ratio: ${media.aspect_ratio}; --media-fit: ${media.object_fit}; --media-position: ${media.object_position};`}
>
  <div class="media-frame__viewport">
    {media.kind === "video" ? (
      <video
        data-media-src={media.src}
        data-media-tier={priority ? "critical" : "deferred"}
        poster={poster?.src}
        width={media.width}
        height={media.height}
        muted
        loop={loop}
        playsinline
        autoplay={autoplay}
        preload="none"
        data-autoplay-media
        aria-label={resolvedAlt}
      />
      <div class="media-frame__progress">
        <input
          type="range"
          min="0"
          max="1000"
          value="0"
          step="1"
          data-media-progress
          aria-label={locale === "zh-CN" ? `${resolvedAlt} 播放进度` : `${resolvedAlt} playback progress`}
        />
      </div>
    ) : (
      <picture>
        {avifSrcset && <source type="image/avif" srcset={avifSrcset} sizes="(max-width: 720px) 94vw, (max-width: 1180px) 86vw, 1280px" />}
        {srcset && <source type="image/webp" srcset={srcset} sizes="(max-width: 720px) 94vw, (max-width: 1180px) 86vw, 1280px" />}
        <img
          src={media.src}
          width={media.width}
          height={media.height}
          alt={resolvedAlt}
          loading={priority ? "eager" : "lazy"}
          decoding="async"
          fetchpriority={priority ? "high" : "auto"}
        />
      </picture>
    )}
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>
