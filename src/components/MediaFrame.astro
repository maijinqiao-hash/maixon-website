---
import { getMedia, type Locale } from "@/data/media";

interface Props {
  id: string;
  locale: Locale;
  posterId?: string;
  alt?: string;
  caption?: string;
  class?: string;
  priority?: boolean;
  autoplay?: boolean;
  controls?: boolean;
}

const {
  id,
  locale,
  posterId,
  alt,
  caption,
  class: className = "",
  priority = false,
  autoplay = false,
  controls = false
} = Astro.props;

const media = getMedia(id, locale);
const poster = posterId ? getMedia(posterId, locale) : undefined;
const resolvedAlt =
  alt ??
  media.alt?.[locale] ??
  (locale === "zh-CN" ? "MAIXON V5.9 产品媒体" : "MAIXON V5.9 product media");
const srcset = media.srcset.map((source) => `${source.src} ${source.width}w`).join(", ");
---

<figure
  class:list={["media-frame", className, { "media-frame--provisional": media.status === "provisional" }]}
  style={`--media-ratio: ${media.aspect_ratio}; --media-fit: ${media.object_fit}; --media-position: ${media.object_position};`}
  data-media-id={media.id}
  data-source-type={media.source_type}
  data-status={media.status}
  data-layout-depends-on-image={String(media.layout_depends_on_image)}
>
  <div class="media-frame__viewport">
    {media.kind === "video" ? (
      <video
        src={media.src}
        poster={poster?.src}
        width={media.width}
        height={media.height}
        muted
        loop
        playsinline
        autoplay={autoplay}
        controls={controls}
        preload={priority ? "auto" : "metadata"}
        data-autoplay-media={autoplay ? "" : undefined}
        aria-label={resolvedAlt}
      />
    ) : (
      <picture>
        {srcset && <source type="image/webp" srcset={srcset} sizes="(max-width: 720px) 94vw, (max-width: 1180px) 86vw, 1280px" />}
        <img
          src={media.src}
          width={media.width}
          height={media.height}
          alt={resolvedAlt}
          loading={priority ? "eager" : "lazy"}
          decoding="async"
          fetchpriority={priority ? "high" : "auto"}
        />
      </picture>
    )}
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>
