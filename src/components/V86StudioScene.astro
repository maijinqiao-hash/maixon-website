---
import scenes from '@/data/v86/studio-scenes.json';
import {assetUrl} from '@/data/asset-delivery';
interface Props {id:string;locale:'zh-CN'|'en'}
const {id,locale}=Astro.props;const zh=locale==='zh-CN';
const scene=scenes.find(item=>item.id===id)!;
const content={
 'print-team':{title:zh?'从图稿，到下一次生产。':'From artwork to the next production run.',description:zh?'让制图、白墨与文件输出衔接起来，准备好接入 MainTop 的下一步。':'Connect image preparation, white ink and file output, ready for the next step in MainTop.',alt:zh?'轻松的印花工作室，同事一起检查图稿，屏幕显示 MAIXON TOOL 浅色界面':'Colleagues reviewing artwork in a print studio with the light MAIXON TOOL interface.',route:'maintop/'},
 'layout-daylight':{title:zh?'一起把排版，安排得更顺手。':'A smoother layout, together.',description:zh?'从单张图到多图排版，把尺寸、白墨和输出设置放在同一个流程里。':'Keep dimensions, white ink and output settings in one flow, from single images to multi-image layouts.',alt:zh?'同事面对电脑操作排版，屏幕显示 MAIXON TOOL 浅色多图排版界面':'Colleagues working at a computer with the light MAIXON TOOL multi-image layout interface.',route:'features/dtf/'},
 'ai-evening':{title:zh?'专注图稿，也照顾工作时的舒适。':'Focus on the artwork. Feel comfortable at work.',description:zh?'在 AI 工作台中处理图稿，用清楚的前后对比查看变化。':'Prepare artwork in the AI Workbench and review changes with a clear before-and-after comparison.',alt:zh?'傍晚的印花工作室，同事面对电脑查看 MAIXON TOOL 深色 AI 工作台':'Colleagues viewing the dark MAIXON TOOL AI Workbench in an evening print studio.',route:'features/ai/'},
 'voice-daylight':{title:zh?'说出要求，接着往下做。':'Say what you need. Keep moving.',description:zh?'用语音或文字描述任务，确认参数后进入对应的生产流程。':'Describe the task by voice or text, then confirm the parameters and continue into the production workflow.',alt:zh?'操作者面对电脑使用语音入口，屏幕显示 MAIXON TOOL 浅色语音作图界面':'An operator using voice input at a computer with the light MAIXON TOOL Voice Commands interface.',route:'features/voice/'}
}[id as 'print-team'|'layout-daylight'|'ai-evening'|'voice-daylight'];
const [p0,p1,,p3]=scene.normalizedQuad;const ratio=scene.height/scene.width;
const initial=`left:${p0[0]*100}%;top:${p0[1]*100}%;transform:matrix(${p1[0]-p0[0]},${(p1[1]-p0[1])*ratio},${(p3[0]-p0[0])/ratio},${p3[1]-p0[1]},0,0)`;
---
<figure class="v86-studio-scene" data-studio-scene={id}>
 <div class="v86-studio-scene__picture" style={`aspect-ratio:${scene.width}/${scene.height}`} data-scene-quad={JSON.stringify(scene.normalizedQuad)}>
  <img class="v86-studio-scene__background" src={assetUrl(scene.background)} width={scene.width} height={scene.height} loading="lazy" decoding="async" alt={content.alt}/>
  <img class="v86-studio-scene__screen" data-scene-screen src={assetUrl(`/media/v86/screenshots/${scene.screen}`)} width="2592" height="1618" loading="lazy" decoding="async" alt="" aria-hidden="true" style={initial}/>
 </div>
 <figcaption><div><h3>{content.title}</h3><p>{content.description}</p></div><a href={`/${locale}/${content.route}`} aria-label={content.title}>↗</a></figcaption>
</figure>
<script>
 document.querySelectorAll<HTMLElement>('[data-scene-quad]').forEach(picture=>{
  const corners=JSON.parse(picture.dataset.sceneQuad!) as number[][];
  const screen=picture.querySelector<HTMLImageElement>('[data-scene-screen]')!;
  const fit=()=>{
   const w=picture.clientWidth,h=picture.clientHeight;if(!w||!h)return;
   const [[x0,y0],[x1,y1],[x2,y2],[x3,y3]]=corners.map(([x,y])=>[x*w,y*h]);
   const dx1=x1-x2,dx2=x3-x2,dx3=x0-x1+x2-x3;
   const dy1=y1-y2,dy2=y3-y2,dy3=y0-y1+y2-y3;
   const determinant=dx1*dy2-dx2*dy1;
   const g=(dx3*dy2-dx2*dy3)/determinant,j=(dx1*dy3-dx3*dy1)/determinant;
   const a=x1-x0+g*x1,b=y1-y0+g*y1,c=x3-x0+j*x3,d=y3-y0+j*y3;
   screen.style.left='0';screen.style.top='0';
   screen.style.transform=`matrix3d(${a/w},${b/w},0,${g/w},${c/h},${d/h},0,${j/h},0,0,1,0,${x0},${y0},0,1)`;
   picture.dataset.sceneReady='true';
  };
  fit();
  if(typeof ResizeObserver==='function')new ResizeObserver(fit).observe(picture);
  else window.addEventListener('resize',fit);
 });
</script>
<style>
.v86-studio-scene{margin:75px 0 10px}.v86-studio-scene__picture{position:relative;isolation:isolate;overflow:hidden;border-radius:20px;background:#e9e6de}.v86-studio-scene__background{display:block;width:100%;height:auto}.v86-studio-scene__screen{position:absolute;width:100%;height:100%;max-width:none;object-fit:fill;transform-origin:0 0;pointer-events:none}.v86-studio-scene figcaption{display:flex;justify-content:space-between;gap:25px;padding:25px 0 0}.v86-studio-scene h3{font-size:clamp(22px,2.3vw,31px);line-height:1.4;letter-spacing:-.035em;margin:0 0 9px;color:inherit}.v86-studio-scene p{max-width:710px;font-size:15px;line-height:1.9;color:inherit;opacity:.68;margin:0}.v86-studio-scene figcaption>a{color:#9b7838;text-decoration:none;font-size:30px;padding:0 8px;align-self:flex-start}.v86-maintop .v86-studio-scene figcaption{color:#eee}.v86-maintop .v86-studio-scene figcaption>a{color:#bb9b57}@media(max-width:700px){.v86-studio-scene{margin-top:45px}.v86-studio-scene__picture{border-radius:12px}.v86-studio-scene figcaption{padding-top:17px;gap:12px}.v86-studio-scene p{font-size:14px}.v86-studio-scene h3{font-size:22px}}
</style>
