---
import {licensingRules} from '@/data/v86/licensing';
interface Props {locale:'zh-CN'|'en';compact?:boolean}
const {locale,compact=false}=Astro.props;const t=licensingRules[locale];
---
<section class="v86-license-rules" id="license-rules">
 <h2>{t.title}</h2>
 <div class="v86-license-grid"><article><span>01</span><h3>{t.worldwideTitle}</h3><p>{t.worldwide}</p></article><article><span>02</span><h3>{t.trialTitle}</h3><p>{t.trial}</p><p class="v86-license-ai">{t.aiTrial}</p></article><article><span>03</span><h3>{t.freeTitle}</h3><p>{t.free}</p></article></div>
 <div class="v86-license-voice"><h3>{t.voiceTitle}</h3><p>{t.voice}</p><div class="v86-voice-examples">{t.voiceExamples.map(([request,result])=><div><strong>{request}</strong><p>{result}</p></div>)}</div><p class="v86-license-example">{t.example}</p></div>
 {!compact&&<div class="v86-license-table"><h3>{t.tableTitle}</h3><table><thead><tr>{t.headings.map(h=><th scope="col">{h}</th>)}</tr></thead><tbody>{t.rows.map(([name,rule])=><tr><th scope="row">{name}</th><td>{rule}</td></tr>)}</tbody></table></div>}
 <p class="v86-license-eligibility">{t.eligibility}</p>
 {compact&&<a href={`/${locale}/authorization/#license-rules`}>{t.link} →</a>}
</section>
<style>
.v86-license-rules{margin:0 0 65px;scroll-margin-top:110px}.v86-license-rules h2{font-size:clamp(28px,3.3vw,44px);line-height:1.3;letter-spacing:-.04em;margin:0 0 35px}.v86-license-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:30px}.v86-license-grid article{padding:25px 0;border-top:1px solid #d5c7ae}.v86-license-grid article>span{font-size:12px;color:#9b7434}.v86-license-rules h3{font-size:21px;line-height:1.5;letter-spacing:-.02em;margin:13px 0}.v86-license-rules p{font-size:15px;line-height:1.9;color:#6d6d72;margin:12px 0}.v86-license-rules .v86-license-ai{color:#896a34;font-size:14px}.v86-license-voice{padding:28px 34px;background:#f5f2eb;border-radius:15px;margin:20px 0 34px}.v86-license-voice h3{margin-top:0}.v86-license-rules .v86-license-example{border-top:1px solid #ddd3c0;padding-top:15px;margin-bottom:0}.v86-license-table table{border-collapse:collapse;width:100%;font-size:15px;line-height:1.8}.v86-license-table th,.v86-license-table td{padding:19px 22px;border-bottom:1px solid #e5e2dc;text-align:left;vertical-align:top}.v86-license-table thead{background:#f5f5f7}.v86-license-table tbody th{font-weight:550;width:27%}.v86-license-table td{color:#6d6d72}.v86-license-rules .v86-license-eligibility{font-size:13px;color:#85817a;margin-top:24px}.v86-license-rules>a{font-size:14px;color:#8f6c2e;text-decoration:none}
.v86-voice-examples{display:grid;grid-template-columns:1fr 1fr;gap:25px;margin:22px 0}.v86-voice-examples>div{background:#fff9;border:1px solid #e3dcca;border-radius:10px;padding:20px}.v86-voice-examples strong{font-size:16px;font-weight:550;line-height:1.8}.v86-voice-examples p{font-size:14px;margin-bottom:0}
@media(max-width:800px){.v86-license-grid,.v86-voice-examples{grid-template-columns:1fr;gap:5px}.v86-voice-examples{gap:15px}.v86-license-grid article{padding:22px 0}.v86-license-voice{padding:24px}.v86-license-table th,.v86-license-table td{padding:15px 10px;font-size:14px}.v86-license-table tbody th{width:32%}.v86-license-rules h3{font-size:20px}.v86-license-rules h2{margin-bottom:26px}}
</style>
