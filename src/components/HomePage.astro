---
import MediaFrame from "@/components/MediaFrame.astro";
import WorkflowSection from "@/components/WorkflowSection.astro";
import type { Locale } from "@/data/media";
import { copy, installer } from "@/data/site";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const content = copy[locale];
---

<section class="hero">
  <div class="hero__copy">
    <p class="hero__descriptor">{content.hero.descriptor}</p>
    <h1>{content.hero.title}</h1>
    <p class="hero__lead">{content.hero.lead}</p>
    <div class="hero__actions">
      <a class="button button--dark" href={installer.url}>{content.hero.primary}</a>
      <a class="button button--ghost" href="#software">{content.hero.secondary}</a>
    </div>
  </div>
  <div class="hero__media">
    <MediaFrame
      id={content.hero.videoId ?? content.hero.mediaId}
      posterId={content.hero.posterId}
      locale={locale}
      priority
      autoplay={Boolean(content.hero.videoId)}
      alt={locale === "zh-CN" ? "MAIXON TOOL V5.9 生产概览" : "MAIXON TOOL V5.9 production overview"}
    />
  </div>
</section>

<section id="software" class="section-intro">
  <p class="section-label">{content.softwareIntro.label}</p>
  <h2>{content.softwareIntro.title}</h2>
  <p>{content.softwareIntro.body}</p>
</section>

<div class="workflow-stack">
  {content.workflows.map((workflow) => (
    <WorkflowSection locale={locale} workflow={workflow} />
  ))}
</div>

<section id="hardware" class="hardware-section">
  <div class="hardware-section__intro">
    <p class="section-label">{content.hardware.label}</p>
    <h2>{content.hardware.title}</h2>
    <p>{content.hardware.body}</p>
  </div>
  <div class="hardware-rail">
    {content.hardware.products.map((product, index) => (
      <article class="hardware-product">
        <a href={product.href} aria-label={product.name}>
          <div class="hardware-product__media">
            <MediaFrame id={product.mediaId} locale={locale} alt={product.name} />
          </div>
          <div class="hardware-product__meta">
            <span>{String(index + 1).padStart(2, "0")}</span>
            <span>{content.hardware.provisional}</span>
          </div>
          <h3>{product.name}</h3>
          <p class="hardware-product__type">{product.type}</p>
          <p>{product.description}</p>
        </a>
      </article>
    ))}
  </div>
</section>

<section id="download" class="download-section">
  <div class="download-section__copy">
    <p class="section-label">{content.download.label}</p>
    <h2>{content.download.title}</h2>
    <p>{content.download.body}</p>
  </div>
  <div class="download-section__details">
    <dl>
      <div>
        <dt>{locale === "zh-CN" ? "版本" : "Version"}</dt>
        <dd>{installer.version}</dd>
      </div>
      <div>
        <dt>{locale === "zh-CN" ? "系统" : "System"}</dt>
        <dd>{installer.os}</dd>
      </div>
      <div>
        <dt>{locale === "zh-CN" ? "大小" : "Size"}</dt>
        <dd>{installer.size}</dd>
      </div>
    </dl>
    <a class="button button--light button--wide" href={installer.url}>{content.download.button}</a>
    <details class="integrity">
      <summary>{content.download.integrity}</summary>
      <code>{installer.sha256}</code>
    </details>
  </div>
</section>

<section id="support" class="support-section">
  <div>
    <p class="section-label">{content.support.label}</p>
    <h2>{content.support.title}</h2>
    <p>{content.support.body}</p>
  </div>
  <nav class="support-links" aria-label={content.support.label}>
    <a href={`/${locale}/support/`}>
      <span>01</span>
      <strong>{content.support.guide}</strong>
    </a>
    <a href="https://wa.me/8615954870827">
      <span>02</span>
      <strong>{content.support.contact}</strong>
    </a>
    <a href={`/${locale}/support/#license`}>
      <span>03</span>
      <strong>{content.support.authorization}</strong>
    </a>
  </nav>
</section>
