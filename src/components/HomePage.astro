---
import BalancedTitle from "@/components/BalancedTitle.astro";
import AutomationStory from "@/components/AutomationStory.astro";
import MediaFrame from "@/components/MediaFrame.astro";
import WorkflowSection from "@/components/WorkflowSection.astro";
import HardwareOverview from "@/components/hardware/HardwareOverview.astro";
import type { Locale } from "@/data/media";
import { copy, installer } from "@/data/site";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const content = copy[locale];
const orderedWorkflows = [
  ...content.workflows.filter((workflow) => workflow.id.startsWith("ai-")),
  ...content.workflows.filter((workflow) => !workflow.id.startsWith("ai-"))
];
---

<section class="hero">
  <div class="hero__copy">
    <p class="hero__descriptor">{content.hero.descriptor}</p>
    <h1>{content.hero.title}</h1>
    <p class="hero__lead">{content.hero.lead}</p>
    <div class="hero__actions">
      <a class="button button--dark" href="#download-selector" data-download-selector-open aria-haspopup="dialog" aria-controls="download-selector">{content.hero.primary}</a>
      <a class="button button--ghost" href="#software">{content.hero.secondary}</a>
    </div>
  </div>
  <div class="hero__media">
    <MediaFrame
      id={content.hero.videoId ?? content.hero.mediaId}
      posterId={content.hero.posterId}
      locale={locale}
      priority
      autoplay={Boolean(content.hero.videoId)}
      alt={locale === "zh-CN" ? "MAIXON TOOL V5.9 生产概览" : "MAIXON TOOL V5.9 production overview"}
    />
  </div>
</section>

<section id="software" class="section-intro">
  <p class="section-label">{content.softwareIntro.label}</p>
  <BalancedTitle
    as="h2"
    text={content.softwareIntro.title}
    segments={content.softwareIntro.titleSegments}
  />
  <p>{content.softwareIntro.body}</p>
</section>

<div class="workflow-stack">
  {orderedWorkflows.map((workflow) => (
    <>
      <WorkflowSection locale={locale} workflow={workflow} />
      {workflow.id === "dtf" && <AutomationStory locale={locale} story="dtf" />}
      {workflow.id === "dtg" && <AutomationStory locale={locale} story="dtg" />}
      {workflow.id === "sublimation" && <AutomationStory locale={locale} story="sublimation" />}
    </>
  ))}
</div>

<HardwareOverview locale={locale} surface="home" />

<section id="download" class="download-section">
  <div class="download-section__copy">
    <p class="section-label">{content.download.label}</p>
    <h2>{content.download.title}</h2>
    <p>{content.download.body}</p>
  </div>
  <div class="download-section__details">
    <dl>
      <div>
        <dt>{locale === "zh-CN" ? "版本" : "Version"}</dt>
        <dd>{installer.version}</dd>
      </div>
      <div>
        <dt>{locale === "zh-CN" ? "系统" : "System"}</dt>
        <dd>{installer.os}</dd>
      </div>
      <div>
        <dt>{locale === "zh-CN" ? "大小" : "Size"}</dt>
        <dd>{installer.size}</dd>
      </div>
    </dl>
    <a class="button button--light button--wide" href="#download-selector" data-download-selector-open aria-haspopup="dialog" aria-controls="download-selector">{content.download.button}</a>
    <details class="integrity">
      <summary>{content.download.integrity}</summary>
      <code>{installer.sha256}</code>
    </details>
  </div>
</section>

<section id="support" class="support-section">
  <div>
    <p class="section-label">{content.support.label}</p>
    <BalancedTitle as="h2" text={content.support.title} segments={content.support.titleSegments} />
    <p>{content.support.body}</p>
  </div>
  <nav class="support-links" aria-label={content.support.label}>
    <a href={`/${locale}/guide/`}>
      <span>01</span>
      <strong>{content.support.guide}</strong>
    </a>
    <a href={`/${locale}/contact/`}>
      <span>02</span>
      <strong>{content.support.contact}</strong>
    </a>
    <a href={`/${locale}/authorization/`}>
      <span>03</span>
      <strong>{content.support.authorization}</strong>
    </a>
  </nav>
</section>
