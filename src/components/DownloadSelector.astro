---
import type { Locale } from "@/data/media";
import { downloadAssistanceResources, downloadPlatforms, downloadResources, downloadSelectorCopy, windows7BeginnerInstaller, windows1011Installer, windows1011BeginnerInstaller } from "@/data/downloads";
import "@/styles/download-selector.css";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const content = downloadSelectorCopy[locale];
---

<dialog
  class="download-selector"
  id="download-selector"
  aria-labelledby="download-selector-title"
  aria-describedby="download-selector-description"
>
  <div class="download-selector__surface">
    <header class="download-selector__header">
      <div>
        <h2 id="download-selector-title">{content.title}</h2>
        <p id="download-selector-description">{content.description}</p>
      </div>
      <button class="download-selector__close" type="button" data-download-selector-close aria-label={content.close}>
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M6.75 6.75 17.25 17.25M17.25 6.75 6.75 17.25"></path>
        </svg>
      </button>
    </header>

    <ol class="download-selector__platforms">
      {downloadPlatforms.map((platform, index) => {
        const platformCopy = content.platforms[platform.id];
        const isAvailable = platform.enabled && platform.installer?.downloadUrl;
        const hasVersionChoice = platform.platform === "windows" && isAvailable;
        return (
          <li class:list={["download-selector__platform", { "is-disabled": !isAvailable }]}>
            <span class="download-selector__number">{String(index + 1).padStart(2, "0")}</span>
            <div class="download-selector__identity">
              <h3>{platform.label}</h3>
              <p>{platformCopy.status}</p>
            </div>
            {isAvailable ? (
              <a
                class="download-selector__action"
                href={platform.installer!.downloadUrl}
                aria-label={`${content.download} ${platform.label}`}
                data-download-action={platform.id}
                data-version-choice={hasVersionChoice ? platform.label : undefined}
                data-version-old={hasVersionChoice ? platform.installer!.downloadUrl : undefined}
                data-version-new={hasVersionChoice ? (platform.id === "windows7" ? windows7BeginnerInstaller.downloadUrl : windows1011BeginnerInstaller.downloadUrl) : undefined}
                aria-haspopup={hasVersionChoice ? "dialog" : undefined}
                aria-controls={hasVersionChoice ? "download-version-selector" : undefined}
              >
                {platformCopy.action}
              </a>
            ) : (
              <button
                class="download-selector__action"
                type="button"
                disabled
                aria-label={`${platform.label} · ${platformCopy.action}`}
                data-download-action={platform.id}
              >
                {platformCopy.action}
              </button>
            )}
          </li>
        );
      })}
    </ol>
    <div class="download-selector__resources">
      <details class="download-selector__assistance">
        <summary class="download-selector__action download-selector__resource">{content.assistance}</summary>
        <div class="download-selector__assistance-options">
          {downloadAssistanceResources.map((resource) => (
            <a
              class="download-selector__action download-selector__resource"
              href={resource.downloadUrl}
              download={resource.filename}
              data-download-resource={resource.id}
            >
              {resource.label[locale]}
            </a>
          ))}
        </div>
      </details>
      {downloadResources.map((resource) => (
        <a
          class="download-selector__action download-selector__resource"
          href={resource.downloadUrl}
          download={resource.filename}
          data-download-resource={resource.id}
        >
          {resource.label[locale]}
        </a>
      ))}
    </div>
  </div>
</dialog>

<dialog
  class="download-selector download-selector--versions"
  id="download-version-selector"
  aria-labelledby="download-version-title"
  aria-describedby="download-version-description"
>
  <div class="download-selector__surface">
    <header class="download-selector__header">
      <div>
        <h2 id="download-version-title">{content.chooseVersion}</h2>
        <p id="download-version-description"><span data-version-platform>Windows 10 / 11</span><span>{content.versionDescription}</span></p>
      </div>
      <button class="download-selector__close" type="button" data-version-close aria-label={content.closeVersion}>
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M6.75 6.75 17.25 17.25M17.25 6.75 6.75 17.25"></path>
        </svg>
      </button>
    </header>

    <ol class="download-selector__platforms download-selector__versions">
      <li class="download-selector__platform">
        <span class="download-selector__number">01</span>
        <div class="download-selector__identity"><h3>V9.2</h3></div>
        <a class="download-selector__action" href={windows1011Installer.downloadUrl}
          aria-label={`${content.download} V9.2`} data-version-download="9.2">{content.download}</a>
      </li>
      <li class="download-selector__platform">
        <span class="download-selector__number">02</span>
        <div class="download-selector__identity">
          <h3>V9.2.1</h3>
          <p class="download-selector__version-badge">{content.beginnerTutorial}</p>
          <p class="download-selector__version-note">{content.voiceNote}</p>
        </div>
        <a class="download-selector__action" href={windows1011BeginnerInstaller.downloadUrl}
          aria-label={`${content.download} V9.2.1`} data-version-download="9.2.1">{content.download}</a>
      </li>
    </ol>
    <button class="download-selector__back" type="button" data-version-back>← <span>{content.back}</span></button>
  </div>
</dialog>

<script>
  const dialog = document.querySelector("#download-selector");
  const versionDialog = document.querySelector("#download-version-selector");

  if (dialog instanceof HTMLDialogElement) {
    const openers = Array.from(document.querySelectorAll("[data-download-selector-open]"));
    const closeButton = dialog.querySelector("[data-download-selector-close]");
    let returnFocus: HTMLElement | null = null;
    let returnVersionFocus: HTMLElement | null = null;

    const openSelector = (event: Event) => {
      event.preventDefault();
      if (dialog.open) return;

      returnFocus = event.currentTarget instanceof HTMLElement ? event.currentTarget : null;
      const mobileNavigation = returnFocus?.closest("details.mobile-nav");
      if (mobileNavigation instanceof HTMLDetailsElement) mobileNavigation.open = false;

      document.documentElement.classList.add("download-selector-open");
      dialog.showModal();
    };

    const closeSelector = () => {
      if (versionDialog instanceof HTMLDialogElement && versionDialog.open) versionDialog.close();
      if (dialog.open) dialog.close();
    };

    if (versionDialog instanceof HTMLDialogElement) {
      dialog.querySelectorAll("[data-version-choice]").forEach((opener) => {
        opener.addEventListener("click", (event) => {
          if (versionDialog.open || !(event.currentTarget instanceof HTMLElement)) return;
          const oldUrl = event.currentTarget.dataset.versionOld;
          const newUrl = event.currentTarget.dataset.versionNew;
          const oldLink = versionDialog.querySelector('[data-version-download="9.2"]');
          const newLink = versionDialog.querySelector('[data-version-download="9.2.1"]');
          if (!oldUrl || !newUrl || !(oldLink instanceof HTMLAnchorElement) || !(newLink instanceof HTMLAnchorElement)) return;
          event.preventDefault();
          oldLink.href = oldUrl;
          newLink.href = newUrl;
          returnVersionFocus = event.currentTarget;
          const platformLabel = versionDialog.querySelector("[data-version-platform]");
          if (platformLabel) platformLabel.textContent = returnVersionFocus.dataset.versionChoice || "Windows 10 / 11";
          versionDialog.showModal();
        });
      });
      const closeVersion = () => { if (versionDialog.open) versionDialog.close(); };
      versionDialog.querySelector("[data-version-close]")?.addEventListener("click", closeVersion);
      versionDialog.querySelector("[data-version-back]")?.addEventListener("click", closeVersion);
      versionDialog.addEventListener("cancel", (event) => { event.preventDefault(); closeVersion(); });
      versionDialog.addEventListener("click", (event) => { if (event.target === versionDialog) closeVersion(); });
      versionDialog.addEventListener("close", () => {
        if (dialog.open) requestAnimationFrame(() => returnVersionFocus?.focus());
      });
    }

    openers.forEach((opener) => opener.addEventListener("click", openSelector));
    closeButton?.addEventListener("click", closeSelector);

    dialog.addEventListener("cancel", (event) => {
      event.preventDefault();
      closeSelector();
    });

    document.addEventListener("keydown", (event) => {
      if (event.key !== "Escape") return;
      if (versionDialog instanceof HTMLDialogElement && versionDialog.open) {
        event.preventDefault();
        versionDialog.close();
      } else if (dialog.open) closeSelector();
    });

    dialog.addEventListener("click", (event) => {
      if (event.target === dialog) closeSelector();
    });

    dialog.addEventListener("close", () => {
      document.documentElement.classList.remove("download-selector-open");
      requestAnimationFrame(() => returnFocus?.focus());
    });
  }
</script>
