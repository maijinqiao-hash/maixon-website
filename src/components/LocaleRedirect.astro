---
import type { Locale } from "@/data/media";
interface Props { locale: Locale; path: string; }
const { locale, path } = Astro.props;
const target = `/${locale}/${path}`;
const title = locale === "zh-CN" ? "前往 V8.6 操作指南" : "Open the V8.6 guide";
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="refresh" content={`0;url=${target}`} />
    <title>{title} · MAIXON</title>
    <link rel="canonical" href={new URL(target, Astro.site)} />
    <link rel="alternate" hreflang="zh-CN" href={new URL(`/zh-CN/${path}`, Astro.site)} />
    <link rel="alternate" hreflang="en" href={new URL(`/en/${path}`, Astro.site)} />
    <link rel="alternate" hreflang="x-default" href={new URL(`/en/${path}`, Astro.site)} />
  </head>
  <body><p><a href={target}>{title}</a></p></body>
</html>
